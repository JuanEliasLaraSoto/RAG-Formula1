# Opcional: si defines esta clave, las respuestas se generan con GPT.
# Sin clave, el sistema responde de forma extractiva con los fragmentos recuperados.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: recuperación por embeddings (captura sinónimos y paráfrasis).
# Valores: bm25 (por defecto, sin dependencias) | embeddings (requiere OPENAI_API_KEY).
RAG_RETRIEVER=bm25
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: ruta de la base de conocimiento para la API (uvicorn src.api:app).
# RAG_DATA=data/f1_data.jsonl
